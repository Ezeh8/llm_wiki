ENV_MODE=production
APP_VERSION=1.0.0

# Hostnames below (`postgres`, `qdrant`, `app`) are Docker Compose service names
# (Step 17) — resolvable only between containers on the compose network. Running the
# app directly on the host instead (no compose) needs `localhost` and the ports
# published in docker-compose.yml (5432, 6333) instead.

# Postgres container bootstrap (Step 17) — the official postgres image's own env vars.
# POSTGRES_ADMIN_USER/PASSWORD must match the credentials embedded in
# DATABASE_ADMIN_URL below; POSTGRES_DB must match both connection strings' database.
POSTGRES_ADMIN_USER=llm_wiki_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin-password
POSTGRES_DB=llm_wiki

# Runtime app connection — restricted role (SELECT/INSERT/UPDATE/DELETE only). This
# role doesn't exist until `alembic upgrade head` creates it (Step 1) — the exact
# username/password here are what that migration uses to create it, not a role that
# must already exist beforehand.
DATABASE_URL=postgresql+asyncpg://llm_wiki_app:change-me-app-password@postgres:5432/llm_wiki
# Migration connection — admin role (CREATE/ALTER/DROP). Used by Alembic (and the
# app's own idempotent startup bootstrap for the Qdrant collection + checkpointer
# tables, Step 17) — never for ordinary runtime queries.
DATABASE_ADMIN_URL=postgresql+asyncpg://llm_wiki_admin:change-me-admin-password@postgres:5432/llm_wiki

# Qdrant vector store (VectorStore adapter — Step 2).
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=llm_wiki

# LLM adapter (Generator — Step 3). Swap providers with LLM_PROVIDER + LLM_MODEL_NAME only.
LLM_PROVIDER=claude              # claude / openai / llama
LLM_MODEL_NAME=claude-sonnet-4-6
# Required only if LLM_PROVIDER is switched to openai — not used by the active claude path.
LLM_MODEL_NAME_OPENAI=
# Required only if LLM_PROVIDER is switched to llama — not used by the active claude path.
LLM_MODEL_NAME_LLAMA=
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
# OpenAI-compatible base URL. Required for the llama provider (vLLM/Ollama/TGI /v1
# endpoint); optional override for openai. Leave blank for claude and hosted OpenAI.
LLM_BASE_URL=

# LangSmith tracing (Stage 2 Step 2). Wraps all 3 LLM adapter clients
# (app/adapters/llm/__init__.py) via langsmith.wrappers.
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true

# Chunking, retrieval, generation (Steps 5-10).
EMBEDDING_MODEL_NAME=nomic-embed-text-v1.5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CACHE_TTL_HOURS=48
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
QUALITY_THRESHOLD=0.65
TOP_K=5
MAX_FILE_SIZE_MB=20
MAX_QUERY_LENGTH=2000

# FastAPI auth/rate limiting (Step 12).
RATE_LIMIT_ADMIN=30
RATE_LIMIT_SERVICE=10
RATE_LIMIT_EMPLOYEE=10

# Dead-letter system (Step 14). Host folder surviving container restarts — mount as
# a volume in production (Step 17).
DEAD_LETTER_PATH=/data/dead-letter

# MCP server (Step 16). Thin wrapper — reaches FastAPI over HTTP only, using the
# Docker Compose service name (Step 17); override to http://localhost:8000 for local
# dev if running both processes on the host directly.
MCP_FASTAPI_BASE_URL=http://app:8000
MCP_RATE_LIMIT_PER_MINUTE=10
MCP_QUERY_TIMEOUT_SECONDS=35
MCP_HOST=0.0.0.0
MCP_PORT=8001
